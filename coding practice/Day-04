# Parallel Builds
##  Jenkins Pipeline - Parallel build & test

pipeline {
  agent any
  stages{
    stage{"Parallel Tasks"}{
      parallel {
        stage('Build') {
            steps {
                sh 'mvn clean complile'
            }
        }
        stage('Test') {
          steps {
               sh "mvn test"
          }
        }
      }
    }
  }
}


## Gitlab CI - Parallel Jobs

stages:
   - build-test

maven-build:
