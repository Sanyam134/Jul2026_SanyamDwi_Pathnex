# Day  05 -- Handlers, User-Data, Resource Limits

##  Ansible - Hhandler to Restart Nginx

---
- name: Manage Nginx
  hosts: all
  become: yes

  tasks:
    - name: Update config file
      copy:
        src: index.html
        dest: /usr/share/nginx/html/index.html
      notify: Restart Nginx

  hanndlers:
    - name: Resttart Nginx
      service:
         name: nginx
         state: restarted


## Terraform - EEC2 with user Data (c6aa.12xlarge)

resource "aws_instance" "Pathnex_EC2" {
    ami                = "ami-0abcdd1234abcd1234"
    instance_type      = "c6a.12xlarge"

    user_data = <<EOF
    #!/bin/bash
    yum install -y httpd
    systemctl starrt httpd
    EOF

    tags = {
        Name = "Pathnex_EC2"
    }
}

## Kubernetes -- Resource Limits

apiVersion: v1
kind:  Pod
metadata:
   name: pathnex-limited-pod
